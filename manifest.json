{
  "manifest_version": 3,
  "name": "KDA",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["assets/c-kda.gif", "assets/besto.gif"],
      "matches": ["https://steam.space-aces.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://steam.space-aces.com/gameNew*"],
      "js": [
        "src/namespace-main.js",
        "src/design-model-main.js",
        "src/source-patch.js",
        "src/page-adapter.js",
        "src/ckda-schema-main.js",
        "src/ckda-core-main.js",
        "src/design-main.js",
        "src/ckda-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://steam.space-aces.com/gameNew*"],
      "css": ["src/loading-screen.css"],
      "js": [
        "src/loading-screen.js",
        "src/design-bootstrap.js",
        "src/namespace.js",
        "src/ckda-schema.js",
        "src/ckda-settings.js",
        "src/design-settings.js",
        "src/ckda-core.js",
        "src/ckda-bridge.js",
        "src/ckda-canvas.js",
        "src/schemas.js",
        "src/settings.js",
        "src/geometry.js",
        "src/planner.js",
        "src/controller.js",
        "src/logger.js",
        "src/bridge.js",
        "src/overlay.js",
        "src/runtime.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
